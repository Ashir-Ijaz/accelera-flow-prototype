# Inbox for project, promotion, and job forms.
# Required for live submissions on Contact, Promotion, and Jobs.
# FormSubmit sends to this address. Leave blank to keep submissions local-only.
# For GitHub Pages, set this as a repository Actions secret / env var at build time.
VITE_INBOX_EMAIL=

# Optional. If set, Web3Forms is used instead of FormSubmit.
VITE_WEB3FORMS_ACCESS_KEY=
